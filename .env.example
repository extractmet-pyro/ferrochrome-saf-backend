# --- FeCr-TWIN backend environment (copy to .env for local runs; set in Render dashboard for cloud) ---
APP_ENV=development                 # production enforces SECRET_KEY and a non-default DEMO_PASSWORD
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./fecr_twin_dev.db   # Render: Internal Database URL of the Postgres instance
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173   # Render: https://<your-frontend>.onrender.com
DEMO_PASSWORD=extractmet-demo       # password of the five seeded role accounts - CHANGE in any shared deployment
JWT_TTL_MIN=480
ADVISORY_ONLY=true                  # false is refused at start-up: no closed-loop path exists
MODEL_DIR=./model_store             # Render: a persistent disk mount, e.g. /var/data/models
SPINUP_H=20                         # warm-start hours simulated when a new furnace size is first requested
MAX_SESSIONS=8
MAX_JOBS=2
MAX_UPLOAD_MB=10
RATE_LIMIT_PER_MIN=600
THERMO_PROVIDER=builtin             # factsage requires a licensed on-prem installation (adapter only)
